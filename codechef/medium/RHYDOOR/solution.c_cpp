
#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while(T--) {
        int N;
        string S;
        cin >> N >> S;

        int count = 0, ans = 0;

        for(int i = 0; i < N; i++) {
            if(i == 0 || S[i] == S[i-1])
                count++;
            else
                count = 1;

            if(count == 3) {
                ans++;
                count = 0;
            }
        }

        cout << ans << endl;
    }

    return 0;
}
